{
  "manifest_version": 3,
  "name": "Book Rating Predictor",
  "version": "1.1",
  "description": "Predicts personal enjoyment and usefulness ratings for books using Ridge, RF, and GBM models",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.goodreads.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.goodreads.com/book/show/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": ["predict.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
